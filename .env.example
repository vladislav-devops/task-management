# Copy this file to .env and adjust values for your environment
#
# Usage:
#   cp .env.example .env
#   # edit .env with your actual credentials, then:
#   docker compose --env-file .env up -d
#
# ── Application ────────────────────────────────────────────────────────────

# Port the FastAPI server listens on (inside the container AND mapped to host)
APP_PORT=8000

# Logging verbosity: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# Image tag. Locally builds and tags as junior-task:latest.
# In CI the deploy step overwrites this with the registry path + commit SHA.
IMAGE_TAG=junior-task:0.1

# ── PostgreSQL ─────────────────────────────────────────────────────────────

# Database superuser credentials (used by both the postgres container and the app)
POSTGRES_USER=user
POSTGRES_PASSWORD=pass
POSTGRES_DB=tasksdb

# Host port mapped to the PostgreSQL container (change if 5432 is already used)
POSTGRES_PORT=5432

# Full DSN for the app (used when running locally WITHOUT Docker)
# NOTE: inside Docker Compose the DSN is auto-assembled to point at the "db" service
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/tasksdb

# ── Redis ──────────────────────────────────────────────────────────────────

# Redis host — use "localhost" when running Python directly, "redis" in Docker
REDIS_HOST=localhost

# Redis port (default is 6379)
REDIS_PORT=6379

# ── Grafana ────────────────────────────────────────────────────────────────

# Grafana
# Change for any real deploy.
GRAFANA_ADMIN_PASSWORD=admin #change-me-please
